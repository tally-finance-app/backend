# Copy to .env and adjust. `cp .env.example .env` should give a working local
# setup as-is — if it doesn't, that's a bug in this file.

# --- Local Postgres (read by docker-compose.yml) ---
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally
POSTGRES_DB=tally
POSTGRES_PORT=5432

# --- Application ---
# Must agree with the POSTGRES_* values above: compose reads those, the app reads
# this one. Nothing enforces that they match, so keep them in sync by hand.
DATABASE_URL=postgres://tally:tally@localhost:5432/tally?sslmode=disable

PORT=8080
LOG_LEVEL=info

# --- FX rate provider (Epic 8 / TALLY-82) ---
# Optional until the FX rate cache exists — the API server boots without them.
# Whatever ends up calling the provider validates them via config.FXConfig.Validate().
FX_API_KEY=
FX_API_URL=
